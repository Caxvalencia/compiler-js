{
  "name": "compiler-js",
  "version": "1.0.0",
  "description": "A compiler tool written with JavaScript",
  "main": "index.js",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsc && c8 mocha build/tests/*.test.js",
    "watch": "concurrently \"tsc --watch\" \"mocha --watch build/tests/*.test.js\"",
    "build": "tsc"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "brace-expansion": "^5.0.8",
      "diff": "8.0.3",
      "js-yaml": "^4.3.0",
      "serialize-javascript": "7.0.5",
      "shell-quote": "^1.9.0",
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@testdeck/mocha": "0.3.3",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "c8": "11.0.0",
    "chai": "^6.2.2",
    "concurrently": "10.0.3",
    "eslint": "^10.4.1",
    "mocha": "^11.7.6",
    "prettier": "3.8.3",
    "typescript": "^6.0.3"
  }
}
